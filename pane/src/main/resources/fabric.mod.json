{
  "schemaVersion": 1,
  "id": "panelib",
  "version": "${version}",
  "name": "PaneLib",
  "description": "A native, client-side UI library for building desktop-quality Minecraft screens entirely from code.",
  "authors": [
    "Sl0oth"
  ],
  "license": "MIT",
  "environment": "client",
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "entrypoints": {
    "client": [
      "dev.pane.ui.PaneClientResources"
    ]
  },
  "mixins": [
    "panelib.mixins.json"
  ]
}
