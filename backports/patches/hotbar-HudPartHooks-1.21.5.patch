+package dev.pane.ui;
+
+import net.minecraft.resources.ResourceLocation;
+
+/** The Fabric layer on these releases groups the hotbar with unrelated survival indicators. */
+public final class HudPartHooks {
+    static final ResourceLocation HOTBAR = ResourceLocation.withDefaultNamespace("hotbar");
+    private HudPartHooks() {}
+    public static boolean hideHotbar() { return UiHud.Registry.replacements.hidden(HOTBAR); }
+}
