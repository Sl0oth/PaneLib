@@ -0,0 +1,38 @@
+package dev.pane.ui;
+
+import com.mojang.blaze3d.vertex.PoseStack;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.gui.GuiComponent;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.util.FormattedCharSequence;
+import net.minecraft.world.item.ItemStack;
+
+/** Immediate-mode drawing context for clients whose screen callback supplies a PoseStack. */
+public final class PortGraphics {
+    private final PoseStack pose;
+    PortGraphics(PoseStack pose) { this.pose = pose; }
+    public PoseStack pose() { return pose; }
+    public int guiWidth() { return Minecraft.getInstance().getWindow().getGuiScaledWidth(); }
+    public int guiHeight() { return Minecraft.getInstance().getWindow().getGuiScaledHeight(); }
+    public void flush() { Minecraft.getInstance().renderBuffers().bufferSource().endBatch(); }
+    public void enableScissor(int x0, int y0, int x1, int y1) { GuiComponent.enableScissor(x0,y0,x1,y1); }
+    public void disableScissor() { GuiComponent.disableScissor(); }
+    public void fill(int x0, int y0, int x1, int y1, int color) { GuiComponent.fill(pose, x0,y0,x1,y1,color); }
+    public void fillGradient(int x0, int y0, int x1, int y1, int top, int bottom) {
+        Gradient.paint(pose, x0, y0, x1, y1, top, bottom);
+    }
+    private static class Gradient extends GuiComponent {
+        static void paint(PoseStack pose, int x0, int y0, int x1, int y1, int top, int bottom) {
+            fillGradient(pose, x0, y0, x1, y1, top, bottom);
+        }
+    }
+    public void drawString(Font font, FormattedCharSequence text, int x, int y, int color, boolean shadow) {
+        if (shadow) font.drawShadow(pose, text, x, y, color);
+        else font.draw(pose, text, x, y, color);
+    }
+    public void renderItem(ItemStack stack, int x, int y) { Minecraft.getInstance().getItemRenderer().renderGuiItem(pose, stack, x, y); }
+    public void blit(ResourceLocation id, int x, int y, int w, int h, float u, float v, int sw, int sh, int tw, int th) {
+        PortBlit.draw(this, id, x, y, x+w, y+h, u/tw, (u+sw)/tw, v/th, (v+sh)/th);
+    }
+}
