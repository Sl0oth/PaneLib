+package dev.pane.ui;
+
+/** Math.clamp overloads used by the Java 17 build. */
+public final class UiClamp {
+    private UiClamp() {}
+    public static int clamp(long value, int low, int high) {
+        if (low > high) throw new IllegalArgumentException("Inverted range");
+        return (int) Math.max(low, Math.min(value, high));
+    }
+    public static float clamp(float value, float low, float high) {
+        if (Float.compare(low, high) > 0 || Float.isNaN(low) || Float.isNaN(high)) throw new IllegalArgumentException("Invalid range");
+        return Math.max(low, Math.min(value, high));
+    }
+    public static double clamp(double value, double low, double high) {
+        if (Double.compare(low, high) > 0 || Double.isNaN(low) || Double.isNaN(high)) throw new IllegalArgumentException("Invalid range");
+        return Math.max(low, Math.min(value, high));
+    }
+}
