+package dev.pane.ui;
+
+import java.util.Map;
+import net.minecraft.resources.ResourceLocation;
+
+/** Maps the identifiers used by PaneLib to vanilla HUD methods on pre-layer-registry clients. */
+public final class HudHooks {
+    private HudHooks() {}
+    private static final Map<String, ResourceLocation> ELEMENTS = java.util.stream.Stream.of(
+        "misc_overlays",
+        "sleep",
+        "overlay_message",
+        "title_and_subtitle",
+        "chat",
+        "scoreboard",
+        "player_list",
+        "crosshair",
+        "status_effects",
+        "hotbar_and_bars",
+        "hotbar",
+        "experience_bar",
+        "experience_level",
+        "held_item_tooltip",
+        "demo_timer",
+        "player_health",
+        "mount_health"
+    ).collect(java.util.stream.Collectors.toUnmodifiableMap(name -> name, ResourceLocation::withDefaultNamespace));
+    static boolean supports(ResourceLocation id) { return id.equals(ELEMENTS.get(id.getPath())); }
+    public static boolean hidden(String name) { return UiHud.Registry.replacements.hidden(ELEMENTS.get(name)); }
+}
